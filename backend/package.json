{
  "name": "sgc-compras-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API del Sistema de Gestión de Solicitudes de Compras y Pedidos",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:interfaz": "npm --prefix ../frontend install && npm --prefix ../frontend run build",
    "db:setup": "node scripts/setupDb.js",
    "db:migrar": "node scripts/migrarDb.js",
    "smoke": "node scripts/smokeTest.js",
    "test:erp": "node scripts/testErpSql.js",
    "test": "node scripts/testErpSql.js && node scripts/testUsuarios.js && node scripts/validarSql.js && node scripts/smokeTest.js",
    "test:sql": "node scripts/validarSql.js",
    "test:usuarios": "node scripts/testUsuarios.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mssql": "^10.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
