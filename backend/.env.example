# ============================================================
#  Copia este archivo como .env y ajusta los valores.
#    cp .env.example .env
# ============================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Origen(es) permitidos para el frontend, separados por coma.
CORS_ORIGIN=http://localhost:5173

# --- Base de datos PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=sgc_compras
PGUSER=postgres
PGPASSWORD=postgres
# Poner true si el servidor de BD exige SSL (ej. servicios en la nube)
PGSSL=false

# --- Seguridad / JWT ---
# ¡CAMBIAR EN PRODUCCIÓN! Cadena larga y aleatoria.
JWT_SECRET=cambia-esta-llave-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# --- Integración ERP Quiter ---
# Si QUITER_BASE_URL está vacío, el sistema usa el catálogo simulado (mock)
# y lo indica en la respuesta con "origen": "MOCK".
QUITER_BASE_URL=
QUITER_API_KEY=
QUITER_TIMEOUT_MS=5000
# Almacén/sucursal por defecto a consultar en Quiter
QUITER_ALMACEN_DEFAULT=SUC01
# Segundos que se cachea en memoria la existencia consultada (0 = sin caché)
ERP_CACHE_TTL_SEG=30
