# ============================================================
#  Copia este archivo como .env y ajusta los valores.
#    cp .env.example .env          (Linux/Mac)
#    copy .env.example .env        (Windows)
#
#  El archivo .env NUNCA se sube al repositorio (lo excluye .gitignore).
# ============================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Origen(es) del frontend permitidos, separados por coma.
# En producción debe ser SOLO el dominio real de la app, nunca "*".
CORS_ORIGIN=http://localhost:5173

# --- Base de datos propia del sistema (PostgreSQL) ---
# Aquí viven las solicitudes, el detalle y la bitácora. No es Quiter.
PGHOST=localhost
PGPORT=5432
PGDATABASE=sgc_compras
PGUSER=postgres
PGPASSWORD=postgres
PGSSL=false

# --- Seguridad / JWT ---
# ¡CAMBIAR EN PRODUCCIÓN! Cadena larga y aleatoria. Generar una así:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-llave-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# ============================================================
#  ERP QUITER — ORIGEN DE EXISTENCIAS
#
#  Opción A (RECOMENDADA): conexión directa a SQL Server.
#  Opción B: API HTTP, si algún día Quiter publica un servicio REST.
#  Si ninguna está configurada, el sistema usa un catálogo simulado
#  y lo advierte en pantalla.
# ============================================================

# --- Opción A: SQL Server de Quiter (solo lectura) ---
# IMPORTANTE: usar un login de SOLO LECTURA creado para este sistema.
# Ver README §6 para el script de creación con permisos mínimos.
ERPSQL_HOST=
ERPSQL_PORT=1433
ERPSQL_DATABASE=
ERPSQL_USER=sgc_compras_ro
ERPSQL_PASSWORD=
# Cifra el tráfico entre esta API y SQL Server. Dejar en true.
ERPSQL_ENCRYPT=true
# true solo si el servidor usa certificado autofirmado (lo normal en red interna).
ERPSQL_TRUST_CERT=true
ERPSQL_TIMEOUT_MS=15000
# Almacenes de refacciones a considerar, separados por coma.
# Estas son las 7 sucursales reales de Quiter (columna ALMACEN de FTIGBI_PR):
#   101=Torreón  102=Gómez Palacio  103=Monclova  104=Piedras Negras
#   201=Durango  202=Poniente       203=Zacatecas
# Quedan fuera a propósito: 102LA (consigna Lala), 104CU (cores usados)
# y 201RE (rescates), que no son sucursales de venta.
ERPSQL_ALMACENES=101,102,103,104,201,202,203

# --- Opción B: API interna de refacciones (catosa-api) ---
# Usa el endpoint /api/existencias, que devuelve la existencia por almacén.
# No requiere credenciales nuevas: ese servidor ya habla con Quiter.
# Dejar vacío si se usa la opción A.
#   QUITER_BASE_URL=https://api.catosaapps.lat
QUITER_BASE_URL=
QUITER_API_KEY=
QUITER_TIMEOUT_MS=5000

# --- Común a ambas opciones ---
# Almacén que se consulta cuando el usuario no tiene sucursal asignada.
ERP_ALMACEN_DEFAULT=101
# Segundos que se cachea en memoria la existencia consultada (0 = sin caché).
ERP_CACHE_TTL_SEG=30
