# ============================================================
#  Copia este archivo como .env y ajusta los valores.
#    copy .env.example .env        (Windows)
#    cp .env.example .env          (Linux/Mac)
#
#  El archivo .env NUNCA se sube al repositorio (lo excluye .gitignore).
# ============================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Origen(es) del frontend permitidos, separados por coma.
# En producción debe ser SOLO el dominio real de la app, nunca "*".
CORS_ORIGIN=http://localhost:5173

# ============================================================
#  BASE DE DATOS PROPIA DEL SISTEMA  (SQL Server)
#
#  Aquí se guardan las solicitudes, sus partidas y la bitácora.
#  Es una base APARTE (SGC_COMPRAS), no la de Quiter.
#  Crearla una sola vez:   CREATE DATABASE SGC_COMPRAS;
# ============================================================
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=SGC_COMPRAS
DB_USER=sa
DB_PASSWORD=
# Cifra el tráfico contra SQL Server. Dejar en true.
DB_ENCRYPT=true
# true si el servidor usa certificado autofirmado (lo normal en red interna).
DB_TRUST_CERT=true

# --- Seguridad / JWT ---
# ¡CAMBIAR EN PRODUCCIÓN! Cadena larga y aleatoria. Generar una así:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-llave-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# ============================================================
#  EXISTENCIAS DE QUITER  — de dónde se leen
#
#  Opción A: la API interna de refacciones (catosa-api).
#            No requiere credenciales: ese servidor ya habla con Quiter.
#            Es la forma más simple de arrancar.
#
#  Opción B: conexión directa al SQL Server de Quiter, con un usuario
#            de SOLO LECTURA. Más control; requiere credenciales.
#
#  Si ninguna está configurada, el sistema usa un catálogo simulado
#  y lo advierte en pantalla.
# ============================================================

# --- Opción A: API interna de refacciones ---
QUITER_BASE_URL=https://api.catosaapps.lat
QUITER_API_KEY=
QUITER_TIMEOUT_MS=5000

# --- Opción B: SQL Server de Quiter (solo lectura) ---
# Si se llenan estos datos, tienen preferencia sobre la opción A.
# Ver README §7 para el script del usuario de solo lectura.
ERPSQL_HOST=
ERPSQL_PORT=1433
ERPSQL_DATABASE=
ERPSQL_USER=sgc_compras_ro
ERPSQL_PASSWORD=
ERPSQL_ENCRYPT=true
ERPSQL_TRUST_CERT=true
ERPSQL_TIMEOUT_MS=15000
# Almacenes de refacciones a considerar, separados por coma.
# Son las 7 sucursales reales de Quiter (columna ALMACEN de FTIGBI_PR):
#   101=Torreón  102=Gómez Palacio  103=Monclova  104=Piedras Negras
#   201=Durango  202=Poniente       203=Zacatecas
# Quedan fuera a propósito: 102LA (consigna Lala), 104CU (cores usados)
# y 201RE (rescates), que no son sucursales de venta.
ERPSQL_ALMACENES=101,102,103,104,201,202,203

# --- Común a ambas opciones ---
# Almacén que se consulta cuando el usuario no tiene sucursal asignada.
ERP_ALMACEN_DEFAULT=101
# Segundos que se cachea en memoria la existencia consultada (0 = sin caché).
ERP_CACHE_TTL_SEG=30
