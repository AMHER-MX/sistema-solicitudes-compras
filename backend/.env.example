# =============================================================================
#  SGC Compras · configuración
#
#  Copia este archivo como `.env` y llena los valores.
#  El .env NUNCA se sube al repositorio (.gitignore ya lo excluye).
#
#  ⚠  Los valores van ENTRE COMILLAS. Sin ellas, un '#' dentro de una
#     contraseña se toma como inicio de comentario y el valor llega cortado.
# =============================================================================

NODE_ENV="development"
PORT="4000"

# Dominio desde el que se abre la aplicación. En el hospedaje, la interfaz y la
# API viven en el mismo dominio, así que esto solo importa en desarrollo.
CORS_ORIGIN="http://localhost:5173"

# ── Base de datos (PostgreSQL) ───────────────────────────────────────────────
#
# En Railway NO se llena nada de esto: el servicio de PostgreSQL entrega
# DATABASE_URL solo, y esa manda sobre todo lo demás.
#
# DATABASE_URL="postgres://usuario:contraseña@host:5432/base"

DB_HOST="localhost"
DB_PORT="5432"
DB_DATABASE="sgc_compras"
DB_USER="postgres"
DB_PASSWORD=""
# En un hospedaje la conexión va cifrada; en tu computadora, no.
DB_SSL="false"

# ── Llave de las sesiones ────────────────────────────────────────────────────
#
# Cadena larga y aleatoria. Quien la conozca puede fabricarse una sesión de
# Gerente, así que en el hospedaje se genera una distinta y no se comparte.
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="8h"

# ── Existencias de Quiter ────────────────────────────────────────────────────
#
# Se leen por la API interna de refacciones, la misma que usa la app de Ventas.
# Si esto queda vacío, el sistema muestra un catálogo SIMULADO: sirve para
# capacitar, pero las existencias no son reales y la interfaz lo advierte.
QUITER_BASE_URL="https://api.catosaapps.lat"
QUITER_TIMEOUT_MS="5000"

# Almacén que se consulta por omisión (clave de ALMACEN en Quiter).
ERP_ALMACEN_DEFAULT="101"
# Segundos que se guarda en memoria una búsqueda, para no golpear el ERP en
# cada tecla del buscador.
ERP_CACHE_TTL_SEG="30"
